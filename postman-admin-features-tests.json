{
  "info": {
    "name": "Bindly Admin Event Features Tests",
    "description": "Postman collection for testing the implemented admin event features: delete events, export registrations, generate QR codes, and event restrictions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "YOUR_ADMIN_JWT_TOKEN_HERE",
      "type": "string"
    },
    {
      "key": "event_id",
      "value": "YOUR_EVENT_ID_HERE",
      "type": "string"
    },
    {
      "key": "restricted_event_id",
      "value": "YOUR_RESTRICTED_EVENT_ID_HERE",
      "type": "string"
    },
    {
      "key": "user_token",
      "value": "YOUR_USER_JWT_TOKEN_HERE",
      "type": "string"
    },
    {
      "key": "allowed_user_token",
      "value": "YOUR_ALLOWED_USER_JWT_TOKEN_HERE",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Delete Event (Admin Only)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/events/{{event_id}}",
          "host": ["{{base_url}}"],
          "path": ["events", "{{event_id}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has success message\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.msg).to.eql(\"Event deleted successfully\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Export Registrations to XLSX (Admin Only)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/events/{{event_id}}/export-registrations",
          "host": ["{{base_url}}"],
          "path": ["events", "{{event_id}}", "export-registrations"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response is XLSX file\", function () {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/vnd.openxmlformats-officedocument.spreadsheetml.sheet');",
              "    pm.expect(pm.response.headers.get('Content-Disposition')).to.include('attachment; filename=\"registrations.xlsx\"');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Export Registrations - Conference (Should Fail)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/events/{{conference_event_id}}/export-registrations",
          "host": ["{{base_url}}"],
          "path": ["events", "{{conference_event_id}}", "export-registrations"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 400\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test(\"Response has error message\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.message).to.eql(\"Cannot export for conferences\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Generate QR Code for Bazaar (Admin Only)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/events/{{bazaar_event_id}}/generate-qr",
          "host": ["{{base_url}}"],
          "path": ["events", "{{bazaar_event_id}}", "generate-qr"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has QR code\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.qrCode).to.be.a('string');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Generate QR Code for Non-Bazaar Event (Should Fail)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/events/{{workshop_event_id}}/generate-qr",
          "host": ["{{base_url}}"],
          "path": ["events", "{{workshop_event_id}}", "generate-qr"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 400\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test(\"Response has error message\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.message).to.eql(\"Invalid event type for QR generation\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Register for Restricted Event - Allowed User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{allowed_user_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": {
          "raw": "{{base_url}}/events/{{restricted_event_id}}/register",
          "host": ["{{base_url}}"],
          "path": ["events", "{{restricted_event_id}}", "register"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has success message\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.msg).to.eql(\"Successfully registered for event\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Register for Restricted Event - Not Allowed User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{user_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": {
          "raw": "{{base_url}}/events/{{restricted_event_id}}/register",
          "host": ["{{base_url}}"],
          "path": ["events", "{{restricted_event_id}}", "register"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 403\", function () {",
              "    pm.response.to.have.status(403);",
              "});",
              "",
              "pm.test(\"Response has access denied message\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.msg).to.eql(\"You are not allowed to register for this event\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}