# OneDrive ignore file
# Exclude node_modules to prevent file locking issues

# Node modules
**/node_modules/
node_modules/

# Build outputs
**/dist/
**/build/
**/.next/
**/out/

# Logs
**/*.log
**/logs/

# Environment files
**/.env
**/.env.*

# Cache directories
**/.cache/
**/.parcel-cache/
**/.npm/

# OS files
**/.DS_Store
**/Thumbs.db

# IDE files
**/.vscode/
**/.idea/
**/*.swp
**/*.swo

# Package manager files
**/package-lock.json
**/yarn.lock
**/pnpm-lock.yaml

